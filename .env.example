# Copy to .env (never commit .env).

# --- Secrets ---
SHOPIFY_STORE=your-store.myshopify.com
# Admin API token with read/write on products, metaobjects, metafields and themes
SHOPIFY_ADMIN_TOKEN=

# --- Configuration (optional) ---
# Overrides "brand" in config/faq-library.json
# COMPANY_NAME=Acme Supply Co.
# CONFIG_DIR=./config
# STATE_DIR=./state
# BACKUP_DIR=./backups
